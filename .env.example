# Postgres (Neon). Required.
DATABASE_URL=

# Secrets: each must be >= 32 random characters in production (server refuses to start otherwise).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
JWT_SECRET=
OTP_SECRET=

# SMS delivery (Twilio). Without it, phone sign-in returns 503 in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Customer support contacts shown in the app and in SMS (optional; hidden when empty)
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_HOURS=Mon-Sat 8am-7pm

# Email delivery (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth (optional, web only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Development only: print verification codes to the server log. Ignored in production.
DEV_LOG_OTP=true

# Integration tests: a Neon branch, never production.
TEST_DATABASE_URL=
